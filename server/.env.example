# --- Database ---
MONGO_URI=mongodb://127.0.0.1:27017/sathya_dress_shop

# --- Server ---
PORT=5000
NODE_ENV=development            # set to "production" on the live server

# --- Security (REQUIRED) ---
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
# The FIRST admin can register freely. Every admin after that must enter this code on the Register page.
ADMIN_REGISTER_CODE=choose_a_private_code

# --- Email (OTP) ---
# Render: use Resend HTTPS API. The onboarding sender can only email your own Resend account.
# Verify a sender/domain in Resend before sending OTPs to other users.
RESEND_API_KEY=
EMAIL_FROM=SATHYA DRESS SHOP <onboarding@resend.dev>
# Local fallback only:
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your_gmail_app_password

# --- Persistent product image storage (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Website URLs allowed to call this API (CORS). Use your real domains when live ---
USER_CLIENT_URL=http://localhost:3000
ADMIN_CLIENT_URL=http://localhost:3001
